<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/jonbeoCountFragment">

    <fragment
        android:id="@+id/jonbeoCountFragment"
        android:name="com.sdhong.jonbeowin.feature.jonbeocount.view.JonbeoCountFragment"
        android:label="fragment_jonbeo_count"
        tools:layout="@layout/fragment_jonbeo_count">
        <action
            android:id="@+id/actionJonbeoCountToAsset"
            app:destination="@id/assetFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="assetId"
                android:defaultValue="0"
                app:argType="integer" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/encourageFragment"
        android:name="com.sdhong.jonbeowin.feature.encourage.view.EncourageFragment"
        android:label="fragment_encourage"
        tools:layout="@layout/fragment_encourage" />

    <fragment
        android:id="@+id/assetFragment"
        android:name="com.sdhong.jonbeowin.feature.asset.view.AssetFragment"
        android:label="fragment_asset"
        tools:layout="@layout/fragment_asset">
        <argument
            android:name="assetId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

</navigation>